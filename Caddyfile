# Divine Astro — reverse proxy and TLS.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically; there is
# no certbot and no renewal cron to forget about.

# DIVASTRO-133: www used to serve a full second copy of the site. Search engines
# treat that as duplicate hosts; one permanent redirect makes the apex the only
# crawlable host (the certificate for www is still issued automatically).
www.divineastro.org {
	redir https://divineastro.org{uri} permanent
}

divineastro.org {
	encode zstd gzip

	# Security headers. The CSP allows exactly the third parties the app can
	# actually reach — Google's sign-in, and the checkout SDKs of gateways that
	# may be selected — and nothing else. Anything added later must be listed
	# here deliberately.
	#
	# Instamojo needs no entry: it is a plain top-level redirect rather than an
	# embedded SDK or iframe, and CSP does not govern `location.assign` to
	# another origin.
	#
	# PayU is different and DOES need one: its hosted checkout is a real
	# <form method=POST> submitted by the page (see openPayu() in
	# account.js), and that IS governed by form-action — without PayU's
	# domains listed there, the browser silently drops the navigation with no
	# catchable JS error, which is exactly what happened the first time this
	# went live (nothing appeared to happen on "Buy").
	#
	# A single https://secure.payu.in entry is NOT enough, and this bit twice:
	# secure.payu.in/_payment 302-redirects to a DIFFERENT origin,
	# api.payu.in, to actually render the checkout page — confirmed by
	# tracing the redirect chain directly (curl, no browser). Chrome's
	# form-action enforcement checks that redirect hop too, not just the
	# form's own action URL, so api.payu.in needs to be allowed as well, and
	# the failure mode is identical: silent, no console error a user would
	# think to look for. Using https://*.payu.in instead of naming each
	# subdomain individually, since PayU's own checkout flow is what decides
	# how many hops and which subdomains are involved, not us, and chasing
	# that one domain at a time every time PayU changes something is not a
	# fight worth re-fighting.
	#
	# Google AdSense (loaded only by index.html) needs script, frame and
	# connect access to its ad-serving domains. `*.google.com` also covers
	# the old accounts.google.com entries; google.co.in is listed because Google
	# serves Indian visitors some ad calls from the country domain, and CSP has
	# no way to wildcard a TLD. fundingchoicesmessages.google.com is the
	# consent (GDPR) message AdSense shows to EU/UK visitors. As with PayU, a
	# missing entry here fails silently: a blank ad slot and a console warning.
	#
	# Google Fonts (DIVASTRO-121): the Kannada, Telugu, Tamil, Malayalam,
	# Bengali and Odia pages load one Noto Sans family for their script — the
	# stylesheet from fonts.googleapis.com (style-src), the font files from
	# fonts.gstatic.com (font-src; without it font-src falls back to
	# default-src 'self' and the font is silently blocked, leaving whatever
	# system font the phone has). Only the active language's font is loaded.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "SAMEORIGIN"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=(), payment=(self)"
		Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.cashfree.com https://checkout.razorpay.com https://*.gstatic.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.google.co.in https://*.googleadservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://sdk.cashfree.com https://api.cashfree.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.google.co.in https://*.googleadservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; frame-src https://sdk.cashfree.com https://api.cashfree.com https://checkout.razorpay.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.google.co.in https://*.googleadservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com; base-uri 'self'; form-action 'self' https://accounts.google.com https://*.payu.in; frame-ancestors 'self'"
		-Server
	}

	# The JSON API and the operator console are never search results (robots.txt
	# already asks crawlers to stay out of both; this is the belt to that braces).
	@noindex path /api/* /admin
	header @noindex X-Robots-Tag "noindex, nofollow"

	# The payment webhook must never be cached or rate-limited away.
	@webhook path /api/webhooks/*
	handle @webhook {
		reverse_proxy app:8000
	}

	# Long-lived SSE stream for narrated answers: no buffering, generous timeout.
	@stream path /api/ask/stream
	handle @stream {
		reverse_proxy app:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 15m
			}
		}
	}

	# Static assets are content-hashed rarely, so a modest cache is right.
	# Static asset filenames are NOT content-hashed, so a long max-age pins
	# visitors to whatever CSS and JS they happened to fetch first — a deploy
	# then takes a day to reach anyone who came back. `no-cache` does not mean
	# "do not store": the browser keeps the file and revalidates with its ETag,
	# so the usual response is an empty 304. Correctness for one cheap request.
	@static path /static/*
	handle @static {
		header Cache-Control "public, no-cache"
		reverse_proxy app:8000
	}

	# Marketing image hosting for the social-media campaign. Deliberately NOT
	# served through the app container: a new post image should never need an
	# app rebuild/redeploy (and the brief app restart that comes with one) —
	# just drop a file in the bind-mounted directory. Filenames are content-
	# addressed (a hash) by whatever writes them, so a long max-age is safe:
	# a changed image gets a new name, never the same URL with new bytes.
	handle_path /marketing/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/marketing
		file_server
	}

	handle {
		reverse_proxy app:8000 {
			transport http {
				response_header_timeout 5m
			}
		}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		# Naam se Kundali Milan (DIVASTRO-115) is a GET form: the names
		# typed into it must never land in this log (app/naam_milan.py).
		format filter {
			wrap json
			fields {
				request>uri query {
					delete boy
					delete girl
					delete boy_pada
					delete girl_pada
				}
			}
		}
	}
}
