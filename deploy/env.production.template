# Divine Astro — PRODUCTION environment.
#
# Copy to C:\Astro\.env before running deploy\provision.ps1. That file is
# gitignored and is uploaded to the VM separately from the code.
#
# Everything marked FILL IN must be set before the site can take money.

# ---------------------------------------------------------------- core
ASTRO_BRAND=Divine Astro
ASTRO_SITE_URL=https://divineastro.org

# Freshly generated for this deployment. Rotating it signs everyone out.
ASTRO_SECRET_KEY=

# HTTPS only in production; Caddy terminates TLS.
ASTRO_COOKIE_SECURE=1
# The no-provider sign-in shortcut. MUST stay 0 in production.
ASTRO_DEV_LOGIN=0

# Postgres password, consumed by docker-compose.yml and the app's DB URL.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- sign-in
# NOTE: rotate this secret — it was shared in plain text during development.
# Google Console -> Credentials -> your OAuth client -> Reset Secret.
GOOGLE_CLIENT_ID=804423572332-k3d6lobd82vurtnc5phurcljpc6jih19.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Phone sign-in by SMS code (DIVASTRO-102). OFF while ASTRO_SMS_PROVIDER is
# blank: the sign-in sheet does not offer it and the endpoints return 404.
# To turn it on: msg91 (the only production sender). Never "console" here —
# that one logs every code and is refused when ASTRO_COOKIE_SECURE=1.
#
# INDIA DLT — required before ANY SMS is delivered: register the business on a
# DLT portal (Jio / Airtel / Vi / BSNL), get a sender header and an OTP content
# template approved, then create the MSG91 template with that DLT template id
# and the variable ##otp##. Without DLT, MSG91 answers "success" and the
# operator silently drops the message.
ASTRO_SMS_PROVIDER=
# FILL IN to enable — MSG91 dashboard -> Authkey / Templates.
ASTRO_MSG91_AUTHKEY=
ASTRO_MSG91_TEMPLATE_ID=
# Calling codes we will text. India only by default; widening this invites
# international SMS-pumping fraud at our expense.
ASTRO_SMS_COUNTRIES=91

# ---------------------------------------------------------------- payments
ASTRO_GATEWAY=cashfree

# FILL IN — Cashfree Dashboard -> Developers -> API Keys (Production).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 0 = live money. Start at 1 with sandbox keys, verify a full purchase, then flip.
CASHFREE_SANDBOX=1
CASHFREE_RETURN_URL=https://divineastro.org/?paid=1

# Register this webhook in the Cashfree dashboard, subscribed to PAYMENT_SUCCESS:
#   https://divineastro.org/api/webhooks/payment

# FILL IN — PayU Dashboard -> Developer -> API Keys -> View Details.
PAYU_MERCHANT_KEY=
PAYU_SALT=
# 1 routes to test.payu.in and needs SEPARATE test credentials from PayU's
# own test-merchant page — the live key/salt above will NOT work against it.
PAYU_SANDBOX=1
# PayU POSTs the browser back here as a real navigation (not a webhook it
# fetches), so this must accept a form-encoded POST, not JSON.
PAYU_SURL=https://divineastro.org/api/payu/return
PAYU_FURL=https://divineastro.org/api/payu/return

# ---------------------------------------------------------------- admin mail
# Who gets admin rights on sign-in, and who gets pinged when a customer
# claims a UPI payment. Comma or space separated.
ASTRO_ADMIN_EMAILS=

# FILL IN to enable the UPI-claim notification AND email sign-in by code
# (DIVASTRO-104): once ASTRO_SMTP_HOST is set, the sign-in sheet offers
# "Email me a sign-in code". Leave it blank and the claim still queues for
# /admin as before, and email sign-in is simply not offered.
ASTRO_SMTP_HOST=
ASTRO_SMTP_PORT=587
ASTRO_SMTP_USER=
ASTRO_SMTP_PASS=
ASTRO_MAIL_FROM=Divine Astro <support@divineastro.org>
# Most sign-in code emails sent in any 24 hours. Brevo's free tier is ~300/day
# and the admin pings share it; past the cap the sheet says email sign-in is
# busy and points to Google / username instead.
ASTRO_EMAIL_DAILY_CAP=250

# ---------------------------------------------------------------- daily web push
# DIVASTRO-112: the opt-in "today's vrat / Rahu Kaal" browser notification.
# Leave BOTH keys blank and the feature is fully off (no button, /sw.js and
# /api/push/* are 404, no sender). Generate a pair once with
#   python -m app.push_keys
# and keep it: changing the keys silently breaks every existing subscription.
ASTRO_VAPID_PUBLIC_KEY=
ASTRO_VAPID_PRIVATE_KEY=
ASTRO_VAPID_SUBJECT=mailto:support@divineastro.org
# The sender is an in-process loop (one uvicorn worker). 0 disables the loop
# while keeping subscribe/unsubscribe working — set it on all but one instance
# if this ever runs more than one worker.
# ASTRO_PUSH_SENDER=1

# ---------------------------------------------------------------- product
ASTRO_FREE_QUESTIONS=10
ASTRO_ASTROLOGER=Pandit Shukla
ASTRO_TURNAROUND_DAYS=10

# ---------------------------------------------------------------- legal
ASTRO_LEGAL_NAME=Yavi Info Solutions and Consultants
ASTRO_ADDRESS=B1-1402 Leisure Park, Greater Noida, Uttar Pradesh, India
ASTRO_SUPPORT_EMAIL=support@divineastro.org
ASTRO_SUPPORT_PHONE=+91 87226 23794
# AGPL-3.0 obliges us to offer source to users. Put the public repo URL here
# and it is linked from /terms.
ASTRO_SOURCE_URL=

# ---------------------------------------------------------------- narration
# Optional. Leave blank and answers use the deterministic engine's wording.
ANTHROPIC_API_KEY=
ASTRO_CLAUDE_MODEL=claude-opus-5
ASTRO_CLAUDE_MAX_TOKENS=4000

# Local-model fallback (see the ollama service in docker-compose.yml): tried
# automatically when Anthropic is unreachable or out of billing, before
# falling back further to the deterministic engine's own wording. Leave both
# blank to skip local inference entirely (Anthropic-or-nothing).
ASTRO_OLLAMA_URL=http://ollama:11434
ASTRO_OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------- registrations
# Shown on /terms, /contact and the public footer. Each appears only when set.
ASTRO_UDYAM_NUMBER=
ASTRO_UDYAM_DATE=
ASTRO_UDYAM_TYPE=
ASTRO_GSTIN=
ASTRO_PAN=

