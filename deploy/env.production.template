# Divine Astro — PRODUCTION environment.
#
# Copy to C:\Astro\.env before running deploy\provision.ps1. That file is
# gitignored and is uploaded to the VM separately from the code.
#
# Everything marked FILL IN must be set before the site can take money.

# ---------------------------------------------------------------- core
ASTRO_BRAND=Divine Astro
ASTRO_SITE_URL=https://divineastro.org

# Freshly generated for this deployment. Rotating it signs everyone out.
ASTRO_SECRET_KEY=

# HTTPS only in production; Caddy terminates TLS.
ASTRO_COOKIE_SECURE=1
# The no-provider sign-in shortcut. MUST stay 0 in production.
ASTRO_DEV_LOGIN=0

# Postgres password, consumed by docker-compose.yml and the app's DB URL.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- sign-in
# NOTE: rotate this secret — it was shared in plain text during development.
# Google Console -> Credentials -> your OAuth client -> Reset Secret.
GOOGLE_CLIENT_ID=804423572332-k3d6lobd82vurtnc5phurcljpc6jih19.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- payments
ASTRO_GATEWAY=cashfree

# FILL IN — Cashfree Dashboard -> Developers -> API Keys (Production).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 0 = live money. Start at 1 with sandbox keys, verify a full purchase, then flip.
CASHFREE_SANDBOX=1
CASHFREE_RETURN_URL=https://divineastro.org/?paid=1

# Register this webhook in the Cashfree dashboard, subscribed to PAYMENT_SUCCESS:
#   https://divineastro.org/api/webhooks/payment

# ---------------------------------------------------------------- admin mail
# Who gets admin rights on sign-in, and who gets pinged when a customer
# claims a UPI payment. Comma or space separated.
ASTRO_ADMIN_EMAILS=

# FILL IN to enable the UPI-claim notification. Leave ASTRO_SMTP_HOST blank
# and the claim still queues for /admin as before — this only adds the ping.
ASTRO_SMTP_HOST=
ASTRO_SMTP_PORT=587
ASTRO_SMTP_USER=
ASTRO_SMTP_PASS=
ASTRO_MAIL_FROM=Divine Astro <support@divineastro.org>

# ---------------------------------------------------------------- product
ASTRO_FREE_QUESTIONS=10
ASTRO_ASTROLOGER=Pandit Shukla
ASTRO_TURNAROUND_DAYS=10

# ---------------------------------------------------------------- legal
ASTRO_LEGAL_NAME=Yavi Info Solutions and Consultants
ASTRO_ADDRESS=B1-1402 Leisure Park, Greater Noida, Uttar Pradesh, India
ASTRO_SUPPORT_EMAIL=support@divineastro.org
ASTRO_SUPPORT_PHONE=+91 87226 23794
# AGPL-3.0 obliges us to offer source to users. Put the public repo URL here
# and it is linked from /terms.
ASTRO_SOURCE_URL=

# ---------------------------------------------------------------- narration
# Optional. Leave blank and answers use the deterministic engine's wording.
ANTHROPIC_API_KEY=
ASTRO_CLAUDE_MODEL=claude-opus-5

# ---------------------------------------------------------------- registrations
# Shown on /terms, /contact and the public footer. Each appears only when set.
ASTRO_UDYAM_NUMBER=
ASTRO_UDYAM_DATE=
ASTRO_UDYAM_TYPE=
ASTRO_GSTIN=
ASTRO_PAN=

