# Divine Astro — configuration
# Copy to `.env` and fill in. Everything has a working default except the
# secrets, so the app runs locally with none of this set.

# ---------------------------------------------------------------- core
ASTRO_BRAND="Divine Astro"
ASTRO_SITE_URL="https://divineastro.org"
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, sessions are signed with a random key and every restart logs
# everyone out.
ASTRO_SECRET_KEY=""
# Set to 1 behind HTTPS so cookies are marked Secure. Leave 0 for local http.
ASTRO_COOKIE_SECURE=0
# Postgres in production: postgresql+psycopg://user:pass@host:5432/astro
ASTRO_DATABASE_URL=""

# ---------------------------------------------------------------- sign-in
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#   OAuth client ID (Web application), in project astro-505710.
#   Authorised redirect URI: https://divineastro.org/api/auth/google/callback
#   For local testing add: http://127.0.0.1:8600/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft: portal.azure.com -> Entra ID -> App registrations -> New.
#   Redirect URI: https://divineastro.org/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# Apple: REQUIRES A PAID APPLE DEVELOPER ACCOUNT ($99/yr). Create a Services ID
# and a Sign in with Apple key (.p8). Apple's "client secret" is a JWT we mint
# from these four values.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Local-only shortcut that signs in without a provider. Never enable in
# production — it is ignored when ASTRO_COOKIE_SECURE=1.
ASTRO_DEV_LOGIN=0

# ---------------------------------------------------------------- payments
# Which gateway to use: paytm | cashfree | razorpay. Leave blank to auto-pick
# whichever has credentials, or fall back to test mode (no real payments).
ASTRO_GATEWAY=""

# Paytm — heaviest KYC of the three; needs a server-side initiateTransaction
# leg before its checkout can open (see gateways.py).
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
PAYTM_WEBSITE="DEFAULT"
PAYTM_STAGING=1
PAYTM_CALLBACK_URL="https://divineastro.org/api/webhooks/payment"

# Cashfree — usually the easiest onboarding for an individual with PAN.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_SANDBOX=1
CASHFREE_RETURN_URL="https://divineastro.org/?paid=1"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Webhook endpoint to register with whichever gateway you choose:
#   https://divineastro.org/api/webhooks/payment

# ---------------------------------------------------------------- product
ASTRO_FREE_QUESTIONS=10
ASTRO_ASTROLOGER="Pandit Shukla"
ASTRO_TURNAROUND_DAYS=10

# ---------------------------------------------------------------- narration
# Optional. The deterministic engine always works without these.
ANTHROPIC_API_KEY=""
ASTRO_CLAUDE_MODEL="claude-opus-5"
ASTRO_OLLAMA_URL="http://127.0.0.1:11434"
ASTRO_OLLAMA_MODEL="qwen2.5:7b"

# ---------------------------------------------------------------- admin mail
# Who gets notified when a customer claims a UPI payment (comma or space
# separated — same list `ASTRO_ADMIN_EMAILS` reads for admin sign-in rights).
ASTRO_ADMIN_EMAILS=""
# Outbound SMTP for that notification. Leave ASTRO_SMTP_HOST blank to disable
# mail entirely — the claim still queues for /admin either way, this only
# controls whether anyone gets pinged about it.
ASTRO_SMTP_HOST=""
ASTRO_SMTP_PORT=587
ASTRO_SMTP_USER=""
ASTRO_SMTP_PASS=""
ASTRO_MAIL_FROM="Divine Astro <support@divineastro.org>"

# ---------------------------------------------------------------- legal
# These appear on /terms, /privacy, /refund and /contact. Payment gateways
# check these pages during activation, so fill them in before applying.
ASTRO_LEGAL_NAME=""
ASTRO_ADDRESS=""
ASTRO_SUPPORT_EMAIL="support@divineastro.org"
ASTRO_SUPPORT_PHONE=""
# AGPL-3.0 requires offering source to users of the service. Put the public
# repository URL here and it is linked from the Terms page.
ASTRO_SOURCE_URL=""

# ---------------------------------------------------------------- registrations
# Shown on /terms, /contact and the public footer. Each appears only when set.
ASTRO_UDYAM_NUMBER=
ASTRO_UDYAM_DATE=
ASTRO_UDYAM_TYPE=
ASTRO_GSTIN=
ASTRO_PAN=

